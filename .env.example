# Runtime
NODE_ENV=production
APP_ENV=development

# Server
HOST=0.0.0.0
PORT=3000
# Takes multiple values separated by `,`. Eg: `CORS_ORIGINS=*, https://example.com`
CORS_ORIGINS=*

# Logging
LOG_LEVEL=debug

# Rate limit
RATE_LIMIT_MAX=100
# Duration of the time window in milliseconds
RATE_LIMIT_TIME_WINDOW=60000
RATE_LIMIT_CACHE=5000
