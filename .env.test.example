# Runtime
NODE_ENV=test
APP_ENV=test

# Server
HOST=0.0.0.0
PORT=3000
# Takes multiple values separated by `,`. Eg: `CORS_ORIGINS=*, https://example.com`
CORS_ORIGINS=*

# Logging
LOG_LEVEL=silent

# Rate limit
RATE_LIMIT_MAX=100
# Duration of the time window in milliseconds
RATE_LIMIT_TIME_WINDOW=1000
RATE_LIMIT_CACHE=5000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_db

# Should be a 256-bit (32 bytes) random key in hex format. Generate with
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=28f5d33371805fb51446b188f39ee00b42c04eaa626412ef5f0f2d7e042d55d7

# Cloudinary
CLOUDINARY_CLOUD_NAME=cloud_name
CLOUDINARY_API_KEY=api_key
CLOUDINARY_API_SECRET=api_secret
CLOUDINARY_FOLDER=folder_name
