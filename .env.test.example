# Runtime
NODE_ENV=test
APP_ENV=test

# Server
HOST=0.0.0.0
PORT=3000
# Takes multiple values separated by `,`. Eg: `CORS_ORIGINS=*, https://example.com`
CORS_ORIGINS=*

# Logging
LOG_LEVEL=silent

# Rate limit
RATE_LIMIT_MAX=100
# Duration of the time window in milliseconds
RATE_LIMIT_TIME_WINDOW=1000
RATE_LIMIT_CACHE=5000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_db
