{
  "name": "server_template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A scalable, opinionated Fastify + TypeScript server template with modern tooling (ESLint, Prettier, Vitest, Pino, Docker, CI/CD, API docs, and more).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "pnpm exec tsx watch src/index.ts",
    "clean": "pnpm exec rimraf dist",
    "build": "pnpm clean && pnpm exec tsc && pnpm exec tsc-alias",
    "start": "node dist/index.js",
    "typecheck": "pnpm exec tsc --noEmit",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm exec eslint . --fix"
  },
  "keywords": [
    "fastify",
    "typescript",
    "template",
    "server",
    "internal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LakshayManglani/server_template.git"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "@types/node": "24.0.1",
    "eslint": "9.29.0",
    "eslint-config-prettier": "10.1.5",
    "prettier": "3.5.3",
    "prettier-plugin-organize-imports": "4.1.0",
    "rimraf": "6.0.1",
    "tsc-alias": "1.8.16",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.1"
  }
}
