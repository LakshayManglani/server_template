{
  "name": "server_template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A scalable, opinionated Fastify + TypeScript server template with modern tooling (ESLint, Prettier, Vitest, Pino, Docker, CI/CD, API docs, and more).",
  "main": "dist/bin/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/bin/server.ts",
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc && tsc-alias",
    "start": "node dist/bin/server.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "prepare": "husky",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "fastify",
    "typescript",
    "template",
    "server",
    "internal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LakshayManglani/server_template.git"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "9.29.0",
    "@types/node": "24.0.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "eslint": "9.29.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-unicorn": "59.0.1",
    "husky": "9.1.7",
    "lint-staged": "16.1.2",
    "pino-pretty": "13.0.0",
    "prettier": "3.5.3",
    "prettier-plugin-organize-imports": "4.1.0",
    "rimraf": "6.0.1",
    "tsc-alias": "1.8.16",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.1",
    "vitepress": "1.6.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "5.1.0",
    "@sinclair/typebox": "0.34.37",
    "env-schema": "6.0.1",
    "fastify": "5.4.0",
    "http-status-codes": "2.3.0"
  }
}
