{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "bracketSpacing": true,
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/",
    "^@/configs/(.*)$",
    "^@/core/(.*)$",
    "^@/plugins/(.*)$",
    "^@/routes/(.*)$",
    "^@/services/(.*)$",
    "^[./]",
    "",
    "<TYPES>^(node:)",
    "<TYPES>",
    "<TYPES>^@",
    "<TYPES>^[./]"
  ],
  "importOrderParserPlugins": ["typescript"],
  "importOrderTypeScriptVersion": "5.0.0",
  "importOrderCaseSensitive": false
}
